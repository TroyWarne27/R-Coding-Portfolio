###Weighting Function
## -1/2 - x + e^(1/2x)
## Weighting of 1/2 at zero distance, weighting at x3 at distance of 4
Weight1 <- function(d){
  
  wt = -(1/2) - d + exp((1/2)*d)

  return(wt)
}

curve(Weight1, from = 0,to=4,xlab = "Weight", ylab = "Distance")

###Prospect Utility Function
U1 <- function(g){
  if (g >= 0){

  u = sqrt(g)
        
  }
  
  else {
    
    u = -2.25*sqrt(-g)
  }
  
  return(u)
}

###Create Initial Vectors
PUD <- 0
PD <- 0
X <- 0
Y <- 0
W <- 0
D <- 0
PX <- 0
PY <- 0
T <- 1
V <- 0
PU <- 0
G <- 0 
U <- 0 

VPA <- function(t_max){

  
    for (i in 2:t_max){
    ### Time Vector
    T[i] <- i
    
    ###Generate Memory Location  
    ## SD of 1 => Most of Density of values between -2,2, distances highly likely to be less than 4
    X[i] <- rnorm(1,0,1)
    Y[i] <- rnorm(1,0,1)
    
    ###Calculate Distance from Previous Prototype
    D[i] <- sqrt((X[i]-PX[i-1])^2+(Y[i]-PY[i-1])^2)
    ### Calculate Weight based on Weighting Function
    W[i] <- Weight1(d=D[i])
    
    ### Calculate Prototype Position
    PX[i] <- weighted.mean(X[1:i],W[1:i])
    PY[i] <- weighted.mean(Y[1:i],W[1:i])
    
    ### Calculate Distance Between Prototypes
    PD[i] <- sqrt((PX[i]-PX[i-1])^2+(PY[i]-PY[i-1])^2)
    
    ###Generate Dollar Value of consumption in time i
    V[i] <- rnorm(1,2.5,4)
    
    ###Calculate Gain/Loss
    G[i] <- V[i] - PU[i-1]
    
    ###Utility for Gain/Loss
    U[i] <- U1(g=G[i])
    
    ###Adjust Protoype Utility for New Experience
    PU[i] <- weighted.mean(U[1:i],W[1:i])


    }
  
  return(PU[t_max])
  
}


