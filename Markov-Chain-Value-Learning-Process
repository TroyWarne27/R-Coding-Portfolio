    PY[i] <- weighted.mean(Y[1:i],W[1:i])
    
    ### Calculate Distance Between Prototypes
    PD[i] <- sqrt((PX[i]-PX[i-1])^2+(PY[i]-PY[i-1])^2)
    
    ###Generate Dollar Value of consumption in time i
    V[i] <- rnorm(1,2.5,4)
    
